#!/usr/bin/env bash
#
# PSCode is a personal fork of Visual Studio Code. Upstream's postinst also registers
# Microsoft's apt repository and signing key so that VS Code updates through apt. PSCode is
# not published to any apt repository, so that whole block is removed: installing this package
# must not add third-party sources or keys to the machine. Update by installing a newer .deb.

# Symlink bin command to /usr/bin
rm -f /usr/bin/@@NAME@@
ln -s /usr/share/@@NAME@@/bin/@@NAME@@ /usr/bin/@@NAME@@

# Register in the alternatives system.
# Priority of 0 should never make it the default editor in auto mode, as most developers
# would prefer a terminal editor as the default.
update-alternatives --install /usr/bin/editor editor /usr/bin/@@NAME@@ 0

# Install the desktop entry
if hash update-desktop-database 2>/dev/null; then
	update-desktop-database
fi

# Update mimetype database to pick up the workspace mimetype
if hash update-mime-database 2>/dev/null; then
	update-mime-database /usr/share/mime
fi
